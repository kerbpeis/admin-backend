PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=admin_backend
MYSQL_CONNECTION_LIMIT=10
JWT_SECRET=change_this_in_development
JWT_EXPIRES_IN=7d

# CORS 跨域白名单（逗号分隔；未配置时开发环境放行全部来源，生产环境拒绝跨域）
# CORS_ORIGINS=https://admin.example.com,https://app.example.com
# 部署在 Nginx 等反向代理后时设为 true（限流按真实客户端 IP 统计）
TRUST_PROXY=false
# 认证用户信息内存缓存时长（毫秒），角色/权限变更最长该时长后生效
AUTH_USER_CACHE_TTL_MS=60000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# 大模型（OpenAI 兼容协议，可选；不配置 LLM_API_KEY 时智能体回退为模板回答）
# 默认 DeepSeek，可切换 Kimi(https://api.moonshot.cn/v1) / 通义(https://dashscope.aliyuncs.com/compatible-mode/v1) / 自建服务
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1200

# 智能体 LLM 每日限流（按用户统计 LLM 生成次数，0 或留空为不限；超限自动回退模板回答）
AGENT_LLM_DAILY_LIMIT=10
# AI 答案缓存时长（毫秒，默认 7 天）；同公司相同问题命中缓存时零 LLM 调用、不计入每日次数
# AGENT_ANSWER_CACHE_TTL_MS=604800000
# 检索直答：命中条款原文时不调模型，直接返回模板+原文（默认开启，false 关闭）
# AGENT_LLM_SKIP_ON_CLAUSE_HIT=true

# Apache Tika 文档解析配置（需 Java 环境）
# TIKA_ENABLED=false 时完全关闭 Tika，使用原有解析器
TIKA_ENABLED=true
# TIKA_AUTO_START=true 时服务会尝试用本地 vendor/tika-server-standard-2.9.1.jar 自动启动 Tika Server
TIKA_AUTO_START=false
# TIKA_HOST=127.0.0.1
# TIKA_PORT=9998
# TIKA_JAR_PATH=vendor/tika-server-standard-2.9.1.jar

# Embedding 向量检索配置（可选；不配置时回退到关键词检索）
# 默认复用 LLM_API_KEY，也可单独配置 EMBEDDING_API_KEY
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=https://api.deepseek.com/v1
# EMBEDDING_MODEL=deepseek-embed
# EMBEDDING_TIMEOUT_MS=30000
# EMBEDDING_BATCH_SIZE=16
